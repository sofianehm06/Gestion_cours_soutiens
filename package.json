{
  "name": "soutienpro",
  "productName": "SoutienPro",
  "version": "1.0.0",
  "description": "Gestion des cours de soutien scolaire : groupes, élèves, présences et paiements",
  "author": "SoutienPro",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "tsc -p tsconfig.json && vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "dz.soutienpro.app",
    "productName": "SoutienPro",
    "npmRebuild": false,
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SoutienPro",
      "artifactName": "SoutienPro-Installation-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SoutienPro-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0"
  }
}
