{
  "name": "gestion-soutien",
  "productName": "Gestion Soutien",
  "version": "2.0.0",
  "description": "Gestion des cours de soutien : élèves, présences et paiements",
  "author": "Gestion Soutien",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "test": "vitest run",
    "licence:init": "node scripts/licence.mjs init",
    "licence:cle": "node scripts/licence.mjs cle",
    "licence:publique": "node scripts/licence.mjs publique"
  },
  "build": {
    "appId": "dz.gestion.soutien",
    "productName": "Gestion Soutien",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gestion Soutien",
      "artifactName": "GestionSoutien-Installation-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GestionSoutien-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0"
  }
}
